# Conexão com o Postgres (use a URL com pooler em produção)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nexo
# Conexão direta, usada só pelas migrações (opcional)
DIRECT_URL=
# Senha do painel admin (mínimo 12 caracteres)
ADMIN_PASSWORD=
# Segredo do JWT do admin (mínimo 32 caracteres)
ADMIN_JWT_SECRET=
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=https://exemplo.vercel.app
PUBLIC_WEB_URL=https://exemplo.vercel.app
PORT=3333
NODE_ENV=development
