generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Participant {
  id             String   @id @default(uuid())
  code           String   @unique
  keyHash        String   @map("key_hash")
  consentAt      DateTime @map("consent_at")
  consentVersion Int      @map("consent_version")
  createdAt      DateTime @default(now()) @map("created_at")

  syncRecords            SyncRecord[]
  questionnaireResponses QuestionnaireResponse[]
  checkins               Checkin[]

  @@map("participants")
}

model SyncRecord {
  id            String    @id @default(uuid())
  participantId String    @map("participant_id")
  entity        String
  entityId      String    @map("entity_id")
  payload       Json
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  // Sequência dedicada: a Task 17 reatribui nextval('sync_server_seq') a cada atualização efetiva.
  serverSeq     BigInt    @unique @default(dbgenerated("nextval('sync_server_seq')")) @map("server_seq")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, entity, entityId])
  @@map("sync_records")
}

model QuestionnaireResponse {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  clientId      String   @map("client_id")
  kind          String
  version       Int
  answers       Json
  score         Int?
  submittedAt   DateTime @map("submitted_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, clientId])
  @@map("questionnaire_responses")
}

model WorkshopSession {
  id          String   @id @default(uuid())
  workshop    Int
  date        DateTime
  location    String
  code        String
  expiresAt   DateTime @map("expires_at")
  manualCount Int      @default(0) @map("manual_count")

  checkins Checkin[]

  @@map("workshop_sessions")
}

model Checkin {
  id            String   @id @default(uuid())
  participantId String   @map("participant_id")
  sessionId     String   @map("session_id")
  createdAt     DateTime @default(now()) @map("created_at")

  participant Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  session     WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([participantId, sessionId])
  @@map("checkins")
}
