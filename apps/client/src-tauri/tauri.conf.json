{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO Check",
  "version": "0.0.0",
  "identifier": "io.github.joaogabrielot.nexocheck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXO Check",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://nexo-check-api.onrender.com http://localhost:3333 https://api.github.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": false,
    "publisher": "NEXO Consultoria",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "android": { "minSdkVersion": 26, "versionCode": 1 }
  }
}
